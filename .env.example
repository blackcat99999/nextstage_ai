# NetSage AI - Environment Variables

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER=gemini   # Options: gemini, openai, anthropic, mock

# API Keys (Provide at least one active key or use mock mode for offline testing)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection
GEMINI_MODEL=gemini-1.5-pro
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# System Configurations
APP_ENV=development
DATASET_PATH=data/cases.csv
RESPONSIBLE_AI_LOG_PATH=reviews/responsible_ai_log.md
REVIEWS_PATH=reviews/human_reviews.csv
TEMPERATURE=0.1
